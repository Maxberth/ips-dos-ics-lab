# Perfil de plataforma: pc-miguel (Ryzen 5 5600X 6c/12t, 24 GB RAM). Mediciones del paper.
# AÚN SIN MEDIR en esta máquina: confirmar la topología con `lscpu -e` y la RAM libre con
# lab/setup/inventario_plataforma.sh pc-miguel antes de usarlo.
PLATFORM=pc-miguel
LAB_USER=CAMBIAR_usuario_de_pc-miguel

HOST_CPUS=0-1
VM_ALLOWED_CPUS=2-11
EMULATOR_CPUS=10-11

MACHINE_MEMORY_HIGH=11G
MACHINE_MEMORY_MAX=12G
MACHINE_SWAP_MAX=0

VM_ATTACKER_MEM=2048; VM_ATTACKER_VCPUS=2; VM_ATTACKER_PIN="2 3"
VM_FW_MEM=1024;       VM_FW_VCPUS=1;       VM_FW_PIN="4"
VM_IPS_MEM=3072;      VM_IPS_VCPUS=2;      VM_IPS_PIN="6 7"
VM_PLC_MEM=1024;      VM_PLC_VCPUS=1;      VM_PLC_PIN="8"
VM_SCADA_MEM=1024;    VM_SCADA_VCPUS=1;    VM_SCADA_PIN="9"
# Suma: 8192 MiB (8 GiB) < MACHINE_MEMORY_HIGH
VM_DISK_GB=8

GUARD_WARN_MEM_MIB=5120
GUARD_PAUSE_MEM_MIB=4096
GUARD_ABORT_MEM_MIB=2560
GUARD_WARN_TCTL=80
GUARD_PAUSE_TCTL=85
GUARD_ABORT_TCTL=90
GUARD_RESUME_TCTL=70
GUARD_PAUSE_PSI=20
GUARD_ABORT_SWAP_GROWTH_MIB=1024
GUARD_REQUIRE_AC=0           # escritorio, sin batería
GUARD_INTERVAL_S=2

RUN_PROFILE_DEFAULT=final
COOLDOWN_TARGET_TCTL=65
