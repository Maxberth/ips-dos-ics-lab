# Perfil de plataforma: laptop-dev (Lenovo IdeaPad Gaming 3, Ryzen 5 6600H 6c/12t, 14,8 GiB RAM).
# Solo para calibración. Los scripts, reglas y arnés son los mismos en todas las plataformas.
PLATFORM=laptop-dev
LAB_USER=maxberth

# --- Topología de CPU (lscpu -e): núcleo N = hilos 2N y 2N+1 ---
HOST_CPUS=0-1                # núcleo 0 reservado para el host, el guardián y la captura
VM_ALLOWED_CPUS=2-11         # machine.slice AllowedCPUs
EMULATOR_CPUS=10-11          # hilos del emulador QEMU (I/O), fuera de las vCPU

# --- machine.slice (límite total de las VMs) ---
MACHINE_MEMORY_HIGH=6G
MACHINE_MEMORY_MAX=6656M     # 6,5 GiB
MACHINE_SWAP_MAX=0

# --- VMs: RAM en MiB, vCPU y pinning (lista de hilos, uno por vCPU) ---
VM_ATTACKER_MEM=1280; VM_ATTACKER_VCPUS=2; VM_ATTACKER_PIN="2 3"
VM_FW_MEM=512;        VM_FW_VCPUS=1;       VM_FW_PIN="4"
VM_IPS_MEM=1536;      VM_IPS_VCPUS=2;      VM_IPS_PIN="6 7"
VM_PLC_MEM=768;       VM_PLC_VCPUS=1;      VM_PLC_PIN="8"
VM_SCADA_MEM=768;     VM_SCADA_VCPUS=1;    VM_SCADA_PIN="9"
# Suma: 4864 MiB (4,75 GiB) < MACHINE_MEMORY_HIGH
VM_DISK_GB=6

# --- Guardián: umbrales (MiB y °C) ---
GUARD_WARN_MEM_MIB=3584      # < 3,5 GiB disponibles
GUARD_PAUSE_MEM_MIB=3072     # < 3 GiB
GUARD_ABORT_MEM_MIB=2048     # < 2 GiB
GUARD_WARN_TCTL=82
GUARD_PAUSE_TCTL=88
GUARD_ABORT_TCTL=93
GUARD_RESUME_TCTL=75         # histéresis: vuelve a OK solo por debajo de esto
GUARD_PAUSE_PSI=20           # /proc/pressure/memory some avg10
GUARD_ABORT_SWAP_GROWTH_MIB=3072   # zram + swappiness 150: el kernel mueve páginas frías aunque haya RAM (D15). Criterios principales: RAM disponible y PSI
GUARD_REQUIRE_AC=1           # si pasa a batería: PAUSE
GUARD_INTERVAL_S=2

# --- Corridas ---
RUN_PROFILE_DEFAULT=reduced  # final: 60 s x 10; reduced: 30 s x 5 (declarar en runs.csv)
COOLDOWN_TARGET_TCTL=65
