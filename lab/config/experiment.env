# Parámetros de las corridas. Iguales en todas las plataformas.
# Perfiles de duración (segundos): calentamiento, ataque, enfriamiento.
piloto_WARM=5;   piloto_ATTACK=30;  piloto_COOL=10
reduced_WARM=10; reduced_ATTACK=30; reduced_COOL=10
final_WARM=15;   final_ATTACK=60;   final_COOL=15
SCADA_HZ=10                 # tráfico legítimo: 10 solicitudes Modbus/s
MODBUS_CONNS=8              # conexiones del ataque Modbus flood
PLC_PROCESS_PATTERN=openplc # patrón de pgrep del proceso PLC dentro de lab-plc
CAPTURE_KEEP_MAX_MB=300     # capturas más grandes se borran tras contarlas (queda el sha256 en el manifest)
OPENPLC_COMMIT=b5d41356dab4aeadca0dd7ca64ba542f870b595d  # HEAD de OpenPLC_v3 el 2026-11-17; mismo commit en todas las plataformas
